# ── SealedBid CLI configuration ───────────────────────────────────────────────
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
#
#   cp .env.example .env
#
# ── Required ──────────────────────────────────────────────────────────────────

# Password used to encrypt the contract's private state on disk (the sealed bid
# amount + nonce, and the identity secret). Required.
#
# Enforced by the level private state provider:
#   - at least 16 characters
#   - at least 3 of: uppercase, lowercase, digits, special characters
#   - no 4+ identical characters in a row
#   - no 4+ sequential character codes (e.g. "abcd", "1234")
#
# There is no recovery mechanism. If you lose this password you lose the ability
# to open any sealed bid stored under it.
MIDNIGHT_STORAGE_PASSWORD=""

# ── Optional ──────────────────────────────────────────────────────────────────

# Wallet seed (32-byte hex) or BIP-39 mnemonic. If unset a fresh seed is
# generated on first run and stored in `cli/.midnight-wallet.json` (gitignored).
# Set this to reuse an existing funded wallet, e.g. in CI.
# MIDNIGHT_SEED=""
# MIDNIGHT_MNEMONIC=""

# How long to wait for the faucet to fund a new testnet address, in ms.
# MIDNIGHT_FAUCET_TIMEOUT_MS=600000

# Override the path to the compiled contract artifacts (the directory holding
# `contract/`, `keys/` and `zkir/`). Defaults to the `@sealedbid/contract`
# workspace build output.
# SEALEDBID_ZK_CONFIG_PATH=""
