{
  "name": "@sealedbid/contract",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The SealedBid Compact smart contract, its witnesses and its test suite.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./managed/sealed-bid-auction/contract": {
      "types": "./dist/managed/sealed-bid-auction/contract/index.d.ts",
      "import": "./dist/managed/sealed-bid-auction/contract/index.js",
      "default": "./dist/managed/sealed-bid-auction/contract/index.js"
    }
  },
  "scripts": {
    "compact": "compact compile src/sealed-bid-auction.compact src/managed/sealed-bid-auction",
    "artifacts": "npm run compact",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:compile": "npm run compact && vitest run",
    "build": "rm -rf dist && tsc --project tsconfig.build.json && cp -Rf ./src/managed ./dist/managed && cp ./src/sealed-bid-auction.compact ./dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
